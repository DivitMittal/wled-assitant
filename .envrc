#!/usr/bin/env bash

if has nix_direnv_version; then
  # A jj workspace under .worktrees/ has no .git of its own, so Nix would resolve the flake
  # against the main checkout's git tree and reject it as untracked. Use the main checkout's
  # flake there instead (same devshell; flake changes are tested from the main checkout).
  main_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -e .git ] || [ -z "$main_root" ]; then
    watch_dir flake
    use flake
  else
    watch_dir "$main_root/flake"
    use flake "$main_root"
  fi
fi
